@@ -38,3 +38,18 @@
 func InverseTransform(transform int32) int32 {
 	return shm.InverseTransform(transform)
 }
+
+// screencopyTransform is the transform still to undo on a whole-output
+// wlr-screencopy buffer. The protocol delivers the output's untransformed
+// pixels, but Hyprland 0.57 renders the frame already in the logical
+// (rotated) orientation, and rotating it again turns 90/270 degree monitors
+// sideways. A buffer sized like the mode with width and height swapped is
+// already rotated.
+func screencopyTransform(output *WaylandOutput, bufWidth, bufHeight int) int32 {
+	t := output.transform
+	if t%2 == 1 && output.width != output.height &&
+		bufWidth == int(output.height) && bufHeight == int(output.width) {
+		return TransformNormal
+	}
+	return t
+}
