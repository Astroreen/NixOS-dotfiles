+/** Warms up Antigravity's model catalog on t3 serve so orchestrator_capabilities lists models immediately. */
+export const warmupAntigravityCommand = `export PATH="$HOME/.local/bin:$HOME/.t3boat/node/bin:$PATH"
+settings="$HOME/.t3/userdata/settings.json"
+[ -s "$settings" ] && jq -e '.providerInstances.antigravity.enabled == true' "$settings" >/dev/null 2>&1 || exit 0
+if [ -s "$HOME/.config/tailscale/authkey" ]; then
+  for _ in $(seq 1 20); do tailscale status >/dev/null 2>&1 && break; sleep 1; done
+fi
+tok=$(t3 auth session issue --base-dir "$HOME/.t3" --ttl 2m --scope orchestration:read --label t3boat-warmup --token-only 2>/dev/null || true)
+[ -n "$tok" ] || exit 0
+ticket=$(curl -fsS -m 5 -X POST -H "Authorization: Bearer $tok" "http://127.0.0.1:${T3_PORT}/api/auth/websocket-ticket" | jq -r '.ticket // empty')
+[ -n "$ticket" ] || exit 0
+node - "$ticket" <<'NODE'
+const ws = new WebSocket(\`ws://127.0.0.1:${T3_PORT}/ws?orchestrationProtocol=2&wsTicket=\${encodeURIComponent(process.argv[2])}\`);
+const done = (code) => { try { ws.close(); } catch {} process.exit(code); };
+setTimeout(() => done(0), 40000).unref();
+ws.addEventListener("open", () => {
+  ws.send(JSON.stringify({ _tag: "Request", id: "1", tag: "server.refreshProviders", payload: { instanceId: "antigravity", refreshModels: true }, headers: [] }));
+});
+ws.addEventListener("message", (ev) => {
+  try { const m = JSON.parse(String(ev.data)); if (m.requestId === "1") done(0); } catch {}
+});
+ws.addEventListener("error", () => done(0));
+NODE
+`;
