{
  pkgs,
  lib,
  config,
  inputs,
  ...
}:
let
  cfg = config.custom.caelestia;
  system = pkgs.stdenv.hostPlatform.system;
in
{
  imports = [
    inputs.caelestia-shell.homeManagerModules.default # Caelestia shell module (programs.caelestia)
  ];

  options = with lib; {
    custom.caelestia = {
      enable = mkEnableOption "Caelestia shell";
      package = mkOption {
        type = types.package;
        default = inputs.caelestia-shell.packages.${system}.with-cli;
        defaultText = literalExpression "inputs.caelestia-shell.packages.\${system}.with-cli";
        description = "Caelestia shell package (with its bundled CLI).";
      };
      cliPackage = mkOption {
        type = types.package;
        default = inputs.caelestia-shell.inputs.caelestia-cli.packages.${system}.default;
        defaultText = literalExpression "inputs.caelestia-shell.inputs.caelestia-cli.packages.\${system}.default";
        description = "`caelestia` CLI package added to PATH.";
      };
      environment = mkOption {
        type = types.listOf types.str;
        default = [ ];
        description = "Environment (`NAME=value`) of the caelestia.service unit.";
      };
      settings = mkOption {
        type = types.attrsOf types.anything;
        default = { };
        description = "Caelestia shell settings, copied (writable) to ~/.config/caelestia/shell.json.";
      };
      settingsOverrides = mkOption {
        type = types.attrsOf types.anything;
        default = { };
        description = "Recursively merged over `settings`, winning on conflicts.";
      };
      recordExtraArgs = mkOption {
        type = types.listOf types.str;
        default = [ ];
        description = ''
          Extra arguments appended to `gpu-screen-recorder` by `caelestia record`.
          Written to ~/.config/caelestia/cli.json as `record.extraArgs`.
        '';
      };
      recorderPackage = mkOption {
        type = types.package;
        default = pkgs.gpu-screen-recorder;
        description = ''
          `gpu-screen-recorder` package used by `caelestia record`. Override per
          host to pin a build whose ffmpeg/nv-codec-headers match the installed
          GPU driver.
        '';
      };
    };
  };

  config = lib.mkIf cfg.enable {

    # The screen recorder lives with the caelestia shell (it is only used there).
    home.packages = [ cfg.recorderPackage ];

    programs.caelestia = {
      enable = true;
      inherit (cfg) package;
      systemd = {
        enable = true;
        inherit (cfg) environment;
      };
      settings = { }; # keep empty so official module skips writing shell.json
      extraConfig = ""; # keep empty
      cli = {
        enable = true; # Also add caelestia-cli to path
        package = cfg.cliPackage;
        settings = { };
      };
    };

    # The caelestia.service unit generated by the programs.caelestia module
    # does NOT set LimitNOFILE, so the process falls back to the Linux
    # kernel's default soft limit of 1024 (confirmed via /proc/<pid>/limits)
    # even though `systemctl --user show caelestia.service -p LimitNOFILE`
    # reports systemd's much higher manager-level default (524288) - that
    # manager default is NOT automatically inherited by a unit that doesn't
    # request it. Under real usage (many QProcess spawns for nmcli, tray
    # icons, media players, etc.) this 1024 cap gets exhausted, causing
    # "QProcess: Cannot create pipe (Too many open files)" and starving
    # sibling processes (VSCode/NeoHtop failed to launch; Electron/libuv
    # apps are especially fd-hungry) sharing the same session/cgroup fd
    # pressure. Merging an explicit LimitNOFILE here (HM merges Service
    # attrsets for the same unit name across module declarations) fixes it
    # without touching the upstream caelestia-shell module.
    systemd.user.services.caelestia.Service.LimitNOFILE = lib.mkDefault "524288";

    # Home activation is used here to not symlink file into nix store, thus making it writable
    home.activation.caelestiaConfig =
      let
        mergedConfig = lib.recursiveUpdate cfg.settings cfg.settingsOverrides;
        configFile = pkgs.writeText "caelestia-config" (builtins.toJSON mergedConfig);
        cliConfigFile = pkgs.writeText "caelestia-cli-config" (
          builtins.toJSON {
            record = {
              extraArgs = cfg.recordExtraArgs;
            };
          }
        );
      in
      lib.hm.dag.entryAfter [ "writeBoundary" ] ''
        CONF="${config.home.homeDirectory}/.config/caelestia/shell.json"
        NEW=${configFile}

        if [ ! -f "$CONF" ] || ! diff -q "$CONF" "$NEW" > /dev/null 2>&1; then
          cp "$NEW" "$CONF"
          chmod 644 "$CONF"
          systemctl --user restart caelestia || true
        fi

        ${lib.optionalString (cfg.recordExtraArgs != [ ]) ''
          CLI="${config.home.homeDirectory}/.config/caelestia/cli.json"
          CLI_NEW=${cliConfigFile}

          if [ ! -f "$CLI" ] || ! diff -q "$CLI" "$CLI_NEW" > /dev/null 2>&1; then
            cp "$CLI_NEW" "$CLI"
            chmod 644 "$CLI"
          fi
        ''}
      '';
  };
}
