+    // Name shown for a player: the desktop entry matching its MPRIS desktop
+    // entry or identity (Electron apps such as Pear report their reverse-DNS
+    // app id as identity), falling back to the raw identity.
+    function displayName(p) {
+        if (!p)
+            return "";
+        const identity = p.identity || "";
+        const id = (("desktopEntry" in p) && p.desktopEntry) ? String(p.desktopEntry) : identity;
+        const entry = id ? DesktopEntries.byId(id) : null;
+        return entry?.name || identity;
+    }
+
     function addPositionRef() {
         positionConsumers++;
     }
